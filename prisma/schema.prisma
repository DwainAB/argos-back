generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  projects Project[]
}

model Project {
  id           String   @id @default(uuid())
  name         String
  githubRepo   String?
  githubBranch String?
  createdAt    DateTime @default(now())

  // Connexion Railway (Project Token en attendant que l'OAuth "Login with Railway"
  // soit fonctionnel côté Railway, voir backend/src/services/railway-oauth.service.ts).
  // TODO : chiffrer railwayProjectToken avant la mise en production.
  railwayProjectToken   String? @db.Text
  railwayServiceId      String?
  railwayEnvironmentId  String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  logs LogEntry[]

  @@index([userId])
}

model LogEntry {
  id         String   @id @default(uuid())
  rawMessage String   @db.Text
  level      String
  source     String
  aiSummary  String?  @db.Text
  createdAt  DateTime @default(now())

  // Identifiant du log tel que fourni par Railway (timestamp de log), utilisé pour éviter
  // d'enregistrer deux fois le même événement lors du polling/streaming.
  externalTimestamp DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
}
