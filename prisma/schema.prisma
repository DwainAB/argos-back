generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())

  accountType      String  @default("personal")
  organizationName String?

  projects Project[]

  receivedProjectShares ProjectShare[]

  membership OrganizationMembership?
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members     OrganizationMembership[]
  invitations OrganizationInvitation[]
  projects    Project[]
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  role      String   @default("user")
  createdAt DateTime @default(now())

  @@index([organizationId])
}

model OrganizationInvitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email     String
  role      String   @default("user")
  createdAt DateTime @default(now())

  @@unique([organizationId, email])
  @@index([email])
}

model Project {
  id                   String   @id @default(uuid())
  name                 String
  githubRepo           String?
  githubBranch         String?
  githubInstallationId Int?
  createdAt            DateTime @default(now())

  railwayProjectToken  String? @db.Text
  railwayServiceId     String?
  railwayEnvironmentId String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  logs   LogEntry[]
  shares ProjectShare[]

  @@index([userId])
  @@index([organizationId])
}

model ProjectShare {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  email            String
  sharedWithUserId String?
  sharedWithUser   User?   @relation(fields: [sharedWithUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([sharedWithUserId])
  @@index([email])
}

model LogEntry {
  id         String   @id @default(uuid())
  rawMessage String   @db.Text
  level      String
  source     String
  aiSummary  String?  @db.Text
  createdAt  DateTime @default(now())

  category String @default("info")

  triageStatus String @default("none")

  originalCategory String?

  externalTimestamp DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  alert Alert?

  @@index([projectId, createdAt])
}

model Alert {
  id          String   @id @default(uuid())
  explanation String   @db.Text
  createdAt   DateTime @default(now())

  status String @default("open")

  resolvedAt DateTime?

  proposedFilePath String? @db.Text
  proposedOldCode  String? @db.Text
  proposedNewCode  String? @db.Text
  pullRequestUrl   String?

  logEntryId String   @unique
  logEntry   LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([status])
}
