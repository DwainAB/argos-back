generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())

  accountType      String  @default("personal")
  organizationName String?

  projects Project[]

  receivedProjectShares ProjectShare[]
}

model Project {
  id                   String   @id @default(uuid())
  name                 String
  githubRepo           String?
  githubBranch         String?
  githubInstallationId Int?
  createdAt            DateTime @default(now())

  railwayProjectToken  String? @db.Text
  railwayServiceId     String?
  railwayEnvironmentId String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  logs   LogEntry[]
  shares ProjectShare[]

  @@index([userId])
}

model ProjectShare {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  email            String
  sharedWithUserId String?
  sharedWithUser   User?   @relation(fields: [sharedWithUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([sharedWithUserId])
  @@index([email])
}

model LogEntry {
  id         String   @id @default(uuid())
  rawMessage String   @db.Text
  level      String
  source     String
  aiSummary  String?  @db.Text
  createdAt  DateTime @default(now())

  category String @default("info")

  triageStatus String @default("none")

  originalCategory String?

  externalTimestamp DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  alert Alert?

  @@index([projectId, createdAt])
}

model Alert {
  id          String   @id @default(uuid())
  explanation String   @db.Text
  createdAt   DateTime @default(now())

  status String @default("open")

  resolvedAt DateTime?

  proposedFilePath String? @db.Text
  proposedOldCode  String? @db.Text
  proposedNewCode  String? @db.Text
  pullRequestUrl   String?

  logEntryId String   @unique
  logEntry   LogEntry @relation(fields: [logEntryId], references: [id])

  @@index([status])
}
