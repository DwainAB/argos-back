generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  projects Project[]
}

model Project {
  id           String   @id @default(uuid())
  name         String
  // Dépôt GitHub associé, au format "owner/repo".
  githubRepo   String?
  githubBranch String?
  // Identifiant de l'installation GitHub App donnant accès à ce dépôt (voir
  // backend/src/services/github-app.service.ts). Nécessaire pour ré-authentifier les
  // appels à l'API GitHub (lecture de code, futures PR) après la connexion initiale.
  githubInstallationId Int?
  createdAt    DateTime @default(now())

  // Connexion Railway (Project Token en attendant que l'OAuth "Login with Railway"
  // soit fonctionnel côté Railway, voir backend/src/services/railway-oauth.service.ts).
  // TODO : chiffrer railwayProjectToken avant la mise en production.
  railwayProjectToken   String? @db.Text
  railwayServiceId      String?
  railwayEnvironmentId  String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  logs LogEntry[]

  @@index([userId])
}

model LogEntry {
  id         String   @id @default(uuid())
  rawMessage String   @db.Text
  level      String
  source     String
  aiSummary  String?  @db.Text
  createdAt  DateTime @default(now())

  // Classification Guardian AI, distincte du "level" brut fourni par Railway.
  // Calculée par des règles simples (voir backend/src/services/log-classifier.service.ts) ;
  // vouée à être affinée par l'IA (Ollama) pour les cas ambigus dans une prochaine étape.
  // Valeurs : "critical" (crash/panne), "warning" (dégradation), "benign" (erreur utilisateur
  // normale, ex: validation), "info" (aucune action requise).
  category String @default("info")

  // Identifiant du log tel que fourni par Railway (timestamp de log), utilisé pour éviter
  // d'enregistrer deux fois le même événement lors du polling/streaming.
  externalTimestamp DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  alert Alert?

  @@index([projectId, createdAt])
}

// Alerte créée quand le triage local (voir backend/src/services/log-triage.service.ts)
// confirme qu'un log "critical"/"warning" est un vrai problème (pas un faux positif).
// Porte aussi le suivi de la demande de correction par IA distante, déclenchée à la
// demande depuis la page de l'alerte (v2).
model Alert {
  id          String   @id @default(uuid())
  explanation String   @db.Text
  createdAt   DateTime @default(now())

  // Statut du cycle de correction. "open" : pas encore de correction demandée.
  // "fix_proposed" : l'IA distante a proposé un correctif, en attente de décision
  // utilisateur. "fix_accepted" : l'utilisateur a validé, la pull request a été ouverte.
  // "fix_rejected" : l'utilisateur a refusé, le correctif proposé reste affiché tel quel.
  status String @default("open")

  // Date à laquelle l'utilisateur a marqué cette alerte comme traitée depuis sa page de
  // détail. Nul tant que l'alerte est encore active. Distinct de "status" : une alerte peut
  // être marquée traitée qu'un correctif ait été proposé ou non.
  resolvedAt DateTime?

  // Correctif proposé par l'IA distante (v2) : fichier concerné, contenu avant/après.
  // Nuls tant qu'aucune correction n'a été demandée ou obtenue.
  proposedFilePath String? @db.Text
  proposedOldCode  String? @db.Text
  proposedNewCode  String? @db.Text
  pullRequestUrl   String?

  logEntryId String   @unique
  logEntry   LogEntry @relation(fields: [logEntryId], references: [id])

  @@index([status])
}
