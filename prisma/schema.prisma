generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())

  // Identifiant Google (claim "sub" du token), renseigné dès qu'un compte existant se
  // connecte au moins une fois via Google — la connexion Google ne crée jamais de compte,
  // elle ne fait que se lier à un compte déjà inscrit par email/mot de passe.
  googleId String? @unique

  accountType      String  @default("personal")
  organizationName String?

  // Vrai dès qu'un essai gratuit Solo a été démarré pour ce compte (même annulé avant
  // terme) — empêche d'en reprendre un nouveau si l'abonnement est résilié puis recréé.
  // Business n'a pas d'essai, donc non concerné.
  hasUsedTrial Boolean @default(false)

  projects Project[]

  receivedProjectShares ProjectShare[]

  membership OrganizationMembership?

  subscription Subscription?

  passwordResetTokens PasswordResetToken[]

  renderApiKeys RenderApiKey[]
}

// Jeton à usage unique envoyé par email pour réinitialiser un mot de passe oublié (page de
// login, utilisateur non connecté). Seul le hash du jeton est stocké : le jeton en clair ne
// transite que dans le lien de l'email, jamais en base.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members     OrganizationMembership[]
  invitations OrganizationInvitation[]
  projects    Project[]

  subscription Subscription?

  renderApiKeys RenderApiKey[]
}

// Un plan Solo (userId renseigné) est porté par un compte personnel ; un plan Business
// (organizationId renseigné) est porté par une organisation et partagé par tous ses
// membres — jamais les deux à la fois sur un même abonnement.
model Subscription {
  id String @id @default(uuid())

  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id])

  plan   String @default("solo")
  status String @default("trialing")

  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique

  currentPeriodEnd DateTime?

  smsUsedThisPeriod         Int @default(0)
  fixesUsedThisPeriod       Int @default(0)
  codeAnalysesUsedThisPeriod Int @default(0)

  smsLimitWarningsSentThisPeriod         Int @default(0)
  fixesLimitWarningsSentThisPeriod       Int @default(0)
  codeAnalysesLimitWarningsSentThisPeriod Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Clé API Render enregistrée une fois par l'utilisateur (ou par l'organisation, partagée par
// tous ses membres — jamais les deux à la fois, même logique que Subscription), pour ne plus
// avoir à la ressaisir à chaque nouveau projet Render. Chiffrée en base (AES-256-GCM, voir
// lib/encryption.ts) : jamais stockée ni renvoyée en clair au frontend.
model RenderApiKey {
  id String @id @default(uuid())

  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Nom donné par l'utilisateur pour se repérer entre plusieurs clés (ex: "Compte perso",
  // "Client X") — jamais la clé elle-même.
  label String @default("Clé Render")

  // Chiffré : payload base64 contenant IV + tag d'authentification + texte chiffré.
  encryptedKey String @db.Text

  // Quatre derniers caractères de la clé en clair, affichés dans l'interface pour aider à
  // distinguer deux clés sans jamais exposer la clé complète.
  lastFour String

  createdAt DateTime @default(now())

  projects Project[]

  @@index([userId])
  @@index([organizationId])
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  role      String   @default("user")
  createdAt DateTime @default(now())

  @@index([organizationId])
}

model OrganizationInvitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email     String
  role      String   @default("user")
  createdAt DateTime @default(now())

  @@unique([organizationId, email])
  @@index([email])
}

model Project {
  id                   String   @id @default(uuid())
  name                 String
  githubRepo           String?
  githubBranch         String?
  githubInstallationId Int?
  createdAt            DateTime @default(now())

  railwayProjectToken  String? @db.Text
  railwayServiceId     String?
  railwayEnvironmentId String?

  renderApiKeyId   String?
  renderApiKeyRef  RenderApiKey? @relation(fields: [renderApiKeyId], references: [id])
  renderOwnerId    String?
  renderResourceId String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Renseigné quand un downgrade Business → Solo laisse ce projet au-delà de la limite du
  // plan Solo : masqué de l'interface et de la collecte de logs tant qu'il est archivé,
  // réactivé automatiquement (remis à null) si le compte repasse à Business.
  archivedAt DateTime?

  logs          LogEntry[]
  shares        ProjectShare[]
  codeAnalyses  CodeAnalysis[]

  @@index([userId])
  @@index([organizationId])
}

// Analyse complète du dépôt GitHub d'un projet par IA (performance, sécurité, architecture,
// secrets exposés, dépendances obsolètes, code mort, gestion d'erreurs, absence de tests).
// Déclenchée manuellement par l'utilisateur, à la différence du triage automatique des logs.
model CodeAnalysis {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status String @default("running") // running | done | failed

  filesScanned Int?

  // Scores 0-10 par catégorie et liste structurée des findings, en JSON plutôt qu'en tables
  // dédiées : la forme exacte est encore amenée à évoluer (catégories, champs par finding).
  scores   Json?
  findings Json?

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId, createdAt])
}

model ProjectShare {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  email            String
  sharedWithUserId String?
  sharedWithUser   User?   @relation(fields: [sharedWithUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([sharedWithUserId])
  @@index([email])
}

model LogEntry {
  id         String   @id @default(uuid())
  rawMessage String   @db.Text
  level      String
  source     String
  aiSummary  String?  @db.Text
  createdAt  DateTime @default(now())

  category String @default("info")

  triageStatus String @default("none")

  originalCategory String?

  externalTimestamp DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  alert Alert?

  @@index([projectId, createdAt])
}

model Alert {
  id          String   @id @default(uuid())
  explanation String   @db.Text
  createdAt   DateTime @default(now())

  status String @default("open")

  // Détermine si une correction de code a un sens pour ce problème : "code" (bug applicatif,
  // corrigible par PR) ou "external" (quota fournisseur, config externe, action à faire par
  // l'utilisateur sur une plateforme tierce — aucune correction de code possible). Tranché dès
  // le triage initial (voir log-triage.service.ts) ; le bouton de correction IA n'est proposé
  // que pour "code".
  fixLocation String @default("code")

  resolvedAt DateTime?

  proposedFilePath String? @db.Text
  proposedOldCode  String? @db.Text
  proposedNewCode  String? @db.Text
  // Explication donnée par l'IA sur SA correction (pourquoi ce changement résout le
  // problème) — distincte du champ `explanation` ci-dessus, qui explique le log lui-même.
  proposedExplanation String? @db.Text
  pullRequestUrl      String?

  logEntryId String   @unique
  logEntry   LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([status])
}
