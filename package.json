    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.1",
    "js-yaml": "^5.5.0",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0",
    "pino": "^10.4.0",
