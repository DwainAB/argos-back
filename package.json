    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^5.19.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.1.1"
