PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL="mysql://user:password@localhost:3306/guardian_ai"

# Authentification — secret utilisé pour signer les JWT de session (cookie httpOnly).
JWT_SECRET=

# Railway — Project Token de test (Project Settings > Tokens), utilisé par scripts/test-railway-logs.ts.
RAILWAY_PROJECT_TOKEN=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# Railway — OAuth App ("Login with Railway"), créée dans Workspace Settings > Developer.
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
RAILWAY_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/railway/callback

# GitHub — GitHub App "Guardian AI" (github.com/settings/apps).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Nom de la GitHub App tel qu'affiché dans son URL publique (github.com/apps/<slug>),
# utilisé pour rediriger l'utilisateur vers la page d'installation.
GITHUB_APP_SLUG=
GITHUB_APP_REDIRECT_URI=http://localhost:4000/api/integrations/github/callback
# Contenu du fichier .pem téléchargé lors de la génération de la clé privée. Coller la clé
# entière en une seule ligne avec des \n littéraux à la place des retours à la ligne,
# ou pointer vers un fichier via GITHUB_APP_PRIVATE_KEY_PATH ci-dessous.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# Ollama — instance locale utilisée pour le triage et l'explication des logs (voir
# backend/src/services/log-triage.service.ts et log-explanation.service.ts).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI — utilisé pour la correction à la demande (exploration du repo + proposition de
# diff, voir backend/src/services/fix-suggestion.service.ts). Nécessite une clé avec accès
# à l'API Chat Completions (platform.openai.com/api-keys).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Resend — envoi des emails (bienvenue, partage de projet, alertes). Tant qu'aucun domaine
# n'est vérifié côté Resend, RESEND_FROM_EMAIL doit rester onboarding@resend.dev, qui ne
# peut envoyer qu'à l'adresse associée au compte Resend utilisé.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Twilio — envoi des SMS d'alerte (console.twilio.com). En mode trial, l'envoi n'est
# possible que vers des numéros vérifiés manuellement dans la console Twilio, et le corps
# du message est forcé à un template prédéfini (voir TWILIO_TRIAL_MODE et sms.service.ts) —
# passer TWILIO_TRIAL_MODE=false une fois le compte upgradé (Billing > Upgrade) pour
# envoyer le vrai texte de l'alerte.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
TWILIO_TRIAL_MODE=true

# Stripe — abonnements Solo/Business (dashboard.stripe.com > Developers > API keys).
# STRIPE_PRICE_SOLO/STRIPE_PRICE_BUSINESS sont les IDs de Price (Product catalog), un par
# plan ; STRIPE_WEBHOOK_SECRET est donné lors de la création du endpoint webhook
# (Developers > Webhooks), ou par `stripe listen` en local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_BUSINESS=

# Rétention des logs (LogEntry) côté Argos AI, indépendante de celle de Railway. Purge
# quotidienne (voir jobs/log-retention.job.ts) de tout log plus vieux que ce seuil.
LOG_RETENTION_DAYS=7
