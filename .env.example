PORT=4000
DATABASE_URL="mysql://user:password@localhost:3306/guardian_ai"

# Railway — Project Token (Project Settings > Tokens), scope à un environnement précis.
RAILWAY_PROJECT_TOKEN=
# Identifiant de l'environnement Railway ciblé (visible dans l'URL du projet Railway).
RAILWAY_ENVIRONMENT_ID=
# Identifiant du service Railway dont on veut les logs.
RAILWAY_SERVICE_ID=
